<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ControlActivity">

    <ScrollView
        android:id="@+id/mainActivityContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Version 1.0" />

            <Button
                android:id="@+id/checkStatusButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="check status" />

            <CheckBox
                android:id="@+id/smartLockCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ENABLE SMART LOCK" />

            <Button
                android:id="@+id/forceCriticalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Force whitelist zone for 2 min" />

            <Button
                android:id="@+id/forceBlacklistButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FORCE BLACKLIST ZONE FOR 2 MIN" />

            <Button
                android:id="@+id/testAlarmButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тестовый Аларм" />

            <CheckBox
                android:id="@+id/tercCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USE TERC" />

            <TextView
                android:id="@+id/checkStatusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/enableAdminButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable Admin" />

                    <Button
                        android:id="@+id/disableAdminButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Disable admin" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/startCronjobButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start periodic job" />

                    <Button
                        android:id="@+id/stopCronjobButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="stop periodic job" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/startAlarmButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="start alarm job" />

                    <Button
                        android:id="@+id/stopAlarmButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="stop alarm job" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/startTimerButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start timer" />

                    <Button
                        android:id="@+id/stopTimerButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="STOP TIMER" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/setAsHomeLauncherButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Run App chooser" />

                    <Button
                        android:id="@+id/resetAppChooserButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESET APP CHOOSER" />
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/usageStatsAccessButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check usage stats access" />

            <Button
                android:id="@+id/overlayPermissionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grant overlay permission (bypass BAL)" />

            <Button
                android:id="@+id/accessibilityServiceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable accessibility service (minimize)" />

            <Button
                android:id="@+id/allFilesAccessButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grant all files access (PDF panel)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PDF folder (scanned recursively):" />

                <EditText
                    android:id="@+id/pdfFolderPathEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:gravity="start|top" />

                <Button
                    android:id="@+id/pdfFolderPathButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save PDF folder path" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TERC check allowed activity URL:" />

                <EditText
                    android:id="@+id/editTercActivityURL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/debugRequestActivityURL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Request URL" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Timezone: MSC" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe Time" />

                    <EditText
                        android:id="@+id/editSafeTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="textPersonName" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Danger Time" />

                    <EditText
                        android:id="@+id/editDangerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="textPersonName" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Critical Time" />

                    <EditText
                        android:id="@+id/editCriticalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="textPersonName" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/saveSettingsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAVE" />

                    <Button
                        android:id="@+id/loadSettingsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOAD" />
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/showLogFilePathButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Log File Path" />

            <Button
                android:id="@+id/homeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOME" />

            <Button
                android:id="@+id/lockFromServiceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOCK FROM SERVICE" />

            <Button
                android:id="@+id/showRunningProcessesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show running processes" />

            <TextView
                android:id="@+id/processListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/showPkgsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="show packages" />

            <TextView
                android:id="@+id/showPkgsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Danger zone black list:" />

                <EditText
                    android:id="@+id/editKillProcessList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:height="400px"
                    android:background="@color/failsafePasswordBackground"
                    android:ems="10"
                    android:gravity="start|top"
                    android:inputType="textMultiLine" />

                <Button
                    android:id="@+id/editDangerzoneBlacklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit danger zone black list" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Critical zone white list:" />

                <EditText
                    android:id="@+id/editWhiteList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:gravity="start|top"
                    android:inputType="textMultiLine" />


                <Button
                    android:id="@+id/editCriticalTimeWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit critical time while list" />

            </LinearLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/saveKillProcessListButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="save process list " />

                    <Button
                        android:id="@+id/loadKillProcessList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="load process list" />
                </TableRow>

            </TableLayout>

            <Button
                android:id="@+id/killProcessListButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="kill processes" />

            <Button
                android:id="@+id/launchAppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="launch" />

            <EditText
                android:id="@+id/launchAppEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="textPersonName"
                android:text="com.google.android.apps.nexuslauncher" />

            <TextView
                android:id="@+id/redirectTargetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="При срабатывании danger/critical зоны будет запущена активность: Danger Zone (список разрешённых приложений)" />

            <Button
                android:id="@+id/anotherHomeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANOTHER HOME (открыть Danger Zone)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <CheckBox
                    android:id="@+id/disablePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disable password period" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/disablePasswordStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <EditText
                        android:id="@+id/disablePasswordEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <Button
                    android:id="@+id/disablePasswordSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SAVE DISABLED PERIODS" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Failsafe password:" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/failsafePasswordEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/failsafePasswordBackground"
                            android:ems="10"
                            android:gravity="start|top"
                            android:inputType="textPassword" />

                        <ImageButton
                            android:id="@+id/failsafePasswordVisibilityToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Show password"
                            android:src="@drawable/ic_visibility" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/failsafePasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save new failsafe password" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blacklist-on-demand password:" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/blacklistOnDemandPasswordEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@color/blacklistPasswordBackground"
                            android:ems="10"
                            android:gravity="start|top"
                            android:inputType="textPassword" />

                        <ImageButton
                            android:id="@+id/blacklistOnDemandPasswordVisibilityToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Show password"
                            android:src="@drawable/ic_visibility" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blacklist-on-demand timeout (minutes):" />

                    <EditText
                        android:id="@+id/blacklistOnDemandTimeoutMinutesEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />

                    <Button
                        android:id="@+id/blacklistOnDemandPasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save blacklist-on-demand settings" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/saveSettingsToFileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save to file..." />

            <Button
                android:id="@+id/loadSettingsFromFileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Load from file..." />
        </LinearLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>